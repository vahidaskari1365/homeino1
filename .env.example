# ============================================================
# HOMEINO — environment configuration
#
# All variables are OPTIONAL for a working build.
# Nothing configured → heuristic LLM + mock image provider,
# and every AI result is honestly labeled "پیش‌نمایش".
#
# NOTE: only variables prefixed with `NEXT_PUBLIC_` are shipped
# to the client. Provider API keys are read on the SERVER only
# and never leak to the bundle.
# ============================================================

# --- Public (safe to expose to the browser) ---
# NEXT_PUBLIC_SITE_URL=https://homeino.ir
# NEXT_PUBLIC_API_BASE_URL=

# --- Supabase (public, client-safe) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           (anon JWT, publishable)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (alternative key)

# --- Supabase (server-only, never NEXT_PUBLIC) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (service_role — server/admin only)
# SUPABASE_JWT_SECRET=<JWT signing secret>
# SUPABASE_SECRET_KEY=sb_secret_...   (paired with the publishable key)

# --- Database (PostgreSQL) ---
# The app (Drizzle + pg) reads DATABASE_URL. Point it at your Supabase
# session-mode pooler (port 5432) so transactions and prepared statements
# keep working — no code changes needed:
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# To create the tables in Supabase, run the bundled migration:
#   npm run db:migrate
# (applies supabase/migrations/*.sql idempotently; also wired as a
#  GitHub Actions workflow: .github/workflows/migrate-supabase.yml)

# --- Auth session ---
# SESSION_SECRET=

# --- Storage: local default; set SUPABASE_* to use Supabase Storage ---
# SUPABASE_STORAGE_BUCKET=ai-assets
# STORAGE_LOCAL_DIR=/home/team/shared/storage
# STORAGE_PUBLIC_URL=/storage
# Individual buckets are provisioned by migration: avatars, product-images,
# vendor-images, inspiration-images, room-images, ai-generations, ai-assets.

# --- Payments (server-side only, never NEXT_PUBLIC) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- LLM service: any OpenAI-compatible /chat/completions endpoint ---
# LLM_API_BASE_URL=https://api.freellmapi.com/v1
# LLM_API_KEY=
# LLM_MODEL=glm-4.7-flash

# --- Orali (server-only) — image-edit + overlay-region engine ---
# ORALI_API_BASE_URL=https://api.orali.com
# ORALI_API_KEY=
# ORALI_MODEL=orali-room-v1

# --- Base image provider (server-only) ---
# GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# FREELLMAPI_API_KEY=
# FREELLMAPI_BASE_URL=

# --- Credit/LLM services read the above only on the server ---

# --- AI engine (Phase 17/20) ---
# AI_SERVER_CREDITS=1        # opt-in: server-side credit gate for /api/ai
#                            # (reserve → run → finalize / refund). Requires
#                            # DATABASE_URL + real auth; keep OFF until the UI
#                            # stops charging credits client-side, otherwise
#                            # users get double-charged.
# AI_DEBUG=1                 # structured per-request AI telemetry lines ([ai] ...)

# ============================================================
# HOMEINO AGENTIC CORE (Agent Registry · Workflow Engine · Memory)
#
# Every variable below is OPTIONAL. With none of them set the platform still
# works: agents run on the built-in local orchestrator, the store falls back to
# an in-process memory adapter, the LLM layer falls back to the deterministic
# heuristic engine, and browser/HTTP tasks fail HONESTLY ("not configured")
# instead of inventing a result.
#
# Secrets are read on the SERVER only. Integration records store the NAME of
# the env var (secretEnvVar) — never the value.
# ============================================================

# --- Agent LLM gateway (provider order: pinned → ollama → dify → langflow → LLM_*) ---
# HOMEINO_LLM_PROVIDER=ollama        # pin one provider: ollama | dify | langflow | openai_compat | heuristic
# HOMEINO_LLM_COST_MICRO_PER_1K=     # cost accounting per 1K tokens, in micro units (integer)
# EMBEDDING_MODEL=nomic-embed-text   # semantic embedding model (Ollama or OpenAI-compatible)

# --- Ollama (local open-source models — no data leaves the machine) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Dify (optional external workflow/agent platform, behind AgentRuntime) ---
# DIFY_API_BASE_URL=https://api.dify.ai/v1
# DIFY_API_KEY=app-...
# DIFY_CHAT_APP_ID=

# --- Langflow (optional external flow runner, behind WorkflowRuntime) ---
# LANGFLOW_BASE_URL=https://langflow.internal
# LANGFLOW_API_KEY=
# LANGFLOW_FLOW_ID=

# --- Mem0 (optional long-term memory MIRROR — the local customer_memories
#     table is always authoritative, so nothing is lost without this) ---
# MEM0_BASE_URL=https://api.mem0.ai
# MEM0_API_KEY=

# --- Browser automation (Browser Use cloud / Stagehand sidecar) ---
# Off by default: the browser agent stays in "draft" and every task fails with
# an honest notConfigured error. Only allowlisted domains may ever be opened.
# BROWSER_USE_API_KEY=
# BROWSER_USE_API_BASE_URL=https://api.browser-use.com
# BROWSER_USE_RUN_PATH=/v1/tasks/run
# STAGEHAND_API_BASE_URL=            # your own Stagehand/Playwright sidecar
# BROWSERBASE_API_KEY=

# --- Outbound HTTP + browser allowlist (comma separated hostnames) ---
# The Homeino site host and the integration hosts above are always allowed.
# HOMEINO_AGENT_ALLOWED_DOMAINS=api.partner.ir,cdn.example.com

# --- Workflow scheduler ---
# On serverless (VERCEL=1) the in-process scheduler is disabled; call the tick
# endpoint from a cron job instead:
#   POST /api/automation/scheduler/tick   with header  Authorization: Bearer $CRON_SECRET
# CRON_SECRET=
# HOMEINO_SCHEDULER_DISABLED=true    # force the in-process scheduler off
