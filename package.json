{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai": "tsc -p scripts/ai-tests/tsconfig.json && node scripts/ai-tests/index.js",
    "test:agents": "tsc -p scripts/ai-tests/tsconfig.json && node -r ./scripts/ai-tests/alias.js node_modules/.cache/ai-tests/scripts/ai-tests/smoke.test.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:migrate": "node scripts/apply-supabase-migrations.mjs",
    "supabase:push": "supabase db push --linked --include-all"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "supabase": "^2.115.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
